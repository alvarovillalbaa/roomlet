name: Temporary Roomlet native workflow
on:
  push:
    branches: [qa/roomlet-ui-20261112-ci4]
    paths: [.github/workflows/native-ui-acceptance.yml]
permissions:
  contents: write
  actions: write
concurrency:
  group: roomlet-native-ui-20261112
  cancel-in-progress: false
jobs:
  retire:
    if: github.repository == 'alvarovillalbaa/roomlet' && github.event.repository.private == false && github.ref == 'refs/heads/qa/roomlet-ui-20261112-ci4'
    runs-on: ubuntu-24.04
    timeout-minutes: 3
    env:
      ROOMLET_RETIREMENT_SOURCE: FINAL_SOURCE
      ROOMLET_PUBLIC_REPOSITORY: ${{ toJSON(github.event.repository.private == false) }}
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803
        with:
          ref: FINAL_SOURCE
          fetch-depth: 2
          persist-credentials: false
          clean: false
      - name: Retire only exact completed controls
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
        run: python3 -I -B -S script/retire_ui_acceptance.py

